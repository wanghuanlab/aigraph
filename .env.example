# Base URL for practical-exam downloads. The default serves exam-assets/ in local development.
# After uploading that directory to TOS, set this to the bucket or CDN origin without a trailing slash.
VITE_EXAM_ASSET_BASE_URL=/exam-assets

# MySQL on the site server (Docker mysql-1panel-8410, host port 11306).
# Copy these into .env and fill MYSQL_PASSWORD. The account can use only the aigraph database.
MYSQL_HOST=wanghuanlab.com
MYSQL_PORT=11306
MYSQL_DATABASE=aigraph
MYSQL_USER=aigraph
MYSQL_PASSWORD=
